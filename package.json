{
  "name": "brsh",
  "version": "2.0.0",
  "description": "An advanced Virtual File System (VFS) and CLI emulator built with Node.js, featuring an in-memory nested inode tree, atomic storage synchronization, and strict path sandboxing",
  "main": "index.ts",
  "scripts": {
    "start": "tsx index.ts",
    "dev": "tsx index.ts",
    "test": "tsx --test --test-concurrency=1 \"tests/**/*.spec.ts\"",
    "test:coverage": "tsx --test --experimental-test-coverage --test-concurrency=1 --test-coverage-include=\"src/**\" \"tests/**/*.spec.ts\""
  },
  "keywords": [],
  "author": "Eduardo Portilho <eduardomportilho@gmail.com>",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cli-color": "^2.0.6",
    "@types/node": "^26.0.0",
    "@types/prompt-sync": "^4.2.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cli-color": "^2.0.4",
    "prompt-sync": "^4.2.0"
  }
}